# Copia questo file in ".env" e compila i valori.

# --- Meta (Facebook + Instagram) — https://developers.facebook.com/apps ---
META_APP_ID=
META_APP_SECRET=
# META_GRAPH_VERSION=v23.0

# --- TikTok — https://developers.tiktok.com/apps ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Fuso orario per date e orari
TIMEZONE=Europe/Rome

# Porta della pagina di collegamento (npm run auth)
AUTH_PORT=8787
# Se TikTok non accetta http://localhost come redirect, usa un tunnel https
# (es. ngrok http 8787) e scrivi qui l'indirizzo pubblico:
# REDIRECT_BASE_URL=https://xxxx.ngrok-free.app

# false = il server MCP non pubblica la coda (usa solo "npm run scheduler")
# SCHEDULER_IN_MCP=true
